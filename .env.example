# 필수 -- 둘 다 채워야 '/rc on' 이 동작합니다.
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here

# 선택 -- 아래는 지우거나 주석인 채로 두어도 됩니다.

# 원격 제어 중 agy 가 그릴 화면 너비. 디스코드 코드블록이 60칸 근처에서
# 접히기 때문에 기본값은 60입니다. 폰에서 주로 본다면 50, 끄려면 0.
#DISHELL_COLS=60

# 실행할 agy 실행 파일 이름 (PATH 에서 찾습니다).
#DISHELL_AGY_BIN=agy

# 진단 로그를 남길 파일. 문제를 신고할 때만 켜세요.
#DISHELL_DEBUG=/tmp/dishell.log
