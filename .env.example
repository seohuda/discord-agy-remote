# 필수 -- 둘 다 채워야 '/rc on' 이 동작합니다.
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here

# 선택 -- 아래는 지우거나 주석인 채로 두어도 됩니다.

# 원격 제어 중 agy 가 그릴 화면 너비. 디스코드 코드블록이 60칸 근처에서
# 접히기 때문에 기본값은 60입니다. 폰에서 주로 본다면 50, 끄려면 0.
#DISHELL_COLS=60

# 실행할 agy 실행 파일 이름 (PATH 에서 찾습니다).
#DISHELL_AGY_BIN=agy

# 입력/출력/argv를 제외한 진단 로그. 문제를 신고할 때만 켜세요.
#DISHELL_DEBUG=/tmp/dishell.log

# 다중 CLI: 실행 파일 설정은 로컬 관리자만 변경합니다.
# Discord /session start 는 아래 네 플러그인 이름만 받으며 인자는 받지 않습니다.
#DISHELL_CODEX_BIN=codex
#DISHELL_CLAUDE_BIN=claude
#DISHELL_OPENCODE_BIN=opencode

# 최초 로컬 세션을 포함한 최대 동시 실행 수 (1~16).
#DISHELL_MAX_SESSIONS=3

# 모든 원격 입력/관리는 버튼 확인 필요. 일회성 승인 TTL (1~300초).
#DISHELL_APPROVAL_TTL=60

# 기본: $XDG_STATE_HOME/dishell/audit.jsonl 또는 ~/.local/state/dishell/audit.jsonl
# 최종 디렉터리는 0700, 파일은 0600이어야 합니다.
# 1 MiB/하루마다 회전, 최대 보관 파일 5개/7일. 다음 기록 시 정리합니다.
#DISHELL_AUDIT_PATH=/home/your-user/.local/state/dishell/audit.jsonl
